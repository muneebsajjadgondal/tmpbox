SECRET_KEY=change-me-to-a-random-value

# Local dev: leave DATABASE_URL and BLOB_READ_WRITE_TOKEN unset to use
# SQLite + local disk automatically. On Vercel, these are injected for you
# when you connect Postgres and Blob storage from the project's Storage tab.
# DATABASE_URL=postgresql://user:pass@host/db
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Shared secret checked on /api/cleanup so only Vercel Cron can trigger it.
# Set the same value in Vercel's project environment variables.
CRON_SECRET=change-me-too

STORAGE_DIR=storage
MAX_CONTENT_LENGTH_MB=100
CLEANUP_INTERVAL_MINUTES=15
